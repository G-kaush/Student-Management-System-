# Supabase PostgreSQL JDBC connection.
# Use the connection string from Supabase Project Settings > Database.
DB_URL=jdbc:postgresql://YOUR_SUPABASE_HOST:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD

# Base64-encoded secret with at least 32 bytes before encoding.
# Generate in PowerShell:
# $bytes = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Fill($bytes); [Convert]::ToBase64String($bytes)
JWT_SECRET=PASTE_GENERATED_BASE64_SECRET_HERE
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000

ADMIN_USERNAME=System Admin
ADMIN_EMAIL=admin@studentmanagement.com
ADMIN_PASSWORD=YourOwnStrongPassword123
